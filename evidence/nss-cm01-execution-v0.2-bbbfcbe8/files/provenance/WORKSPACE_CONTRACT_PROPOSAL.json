{
  "id": "NSS_CM01_WORKSPACE_CONTRACT_PROPOSAL_v0.1",
  "status": "proposed_codec_not_a_native_neural_token_interface",
  "codec": {
    "name": "UTF8_BYTE_V1",
    "symbol_definition": "one_UTF8_byte",
    "permitted_bytes": "ASCII_only_for_this_schema",
    "maximum_symbols": 64,
    "sample": "01|00000003|0000000000000011|00000004|000000000000005b|R",
    "sample_bytes": 56,
    "serialized_bytes": 56,
    "grammar_regex": "^01\\|[0-9a-f]{8}\\|[0-9a-f]{16}\\|[0-9a-f]{8}\\|[0-9a-f]{16}\\|[RUH]$",
    "fields_order": [
      "version",
      "scope",
      "handle",
      "revision",
      "binding_event",
      "operation"
    ],
    "reserved_zero": "all_numeric_fields_zero_means_no_reference_only_when_operation_U",
    "operations": {
      "R": "proposed_resolution_request_not_an_authority_grant",
      "U": "no_reference_or_unresolved",
      "H": "hold_due_to_observable_conflict"
    },
    "invalid_policy": "fail_closed_with_explicit_schema_error_no_silent_truncation_no_task_success_credit",
    "encoded_R_constraints": "all_numeric_fields_nonzero; scope/handle/revision/task-binding must be checked against permitted visible evidence",
    "unresolved_or_hold_policy": "any retained proposal fields remain untrusted; U/H alone cannot certify origin or UNKNOWN truth",
    "not_counted_as": "natural_language_model_tokens_or_native_embedding_slots"
  },
  "public_manager_inputs": [
    "K",
    "V",
    "valid",
    "Q",
    "observable_registration_selection_and_revision_events",
    "current_public_scope_and_task_binding",
    "manager_retained_workspace"
  ],
  "private_inputs_forbidden": [
    "hidden_source_identity",
    "query_kind",
    "anchor_label",
    "protected_owner_arrays",
    "expected_answer_ledger"
  ],
  "base_decoder": "unchanged_original_resolver_with_existing_catalogue_assistance_disclosed",
  "allowed_actions": [
    "use_original_Q",
    "use_canonical_public_journal_key",
    "management_abstention"
  ],
  "query_variants_per_reader_case_max": 2,
  "non_mutation": [
    "K",
    "V",
    "valid",
    "model_weights",
    "original_resolver",
    "original_learned_decision_rule"
  ],
  "two_truth_layers": [
