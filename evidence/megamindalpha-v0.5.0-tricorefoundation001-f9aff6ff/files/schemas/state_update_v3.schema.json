{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "caller_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        }
      },
      "required": [
        "agent_id",
        "project_id",
        "session_id"
      ],
      "additionalProperties": false
    },
    "expected_record_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "proposer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN_LOCAL_ATTESTATION"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "reviewed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "reviewer_id",
        "proposal_sha256",
        "reviewed_at",
        "expires_at",
        "decision",
        "reason"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "UPDATE_STATE"
      ]
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "SET_GOAL",
              "ADD_QUESTION",
              "RESOLVE_QUESTION",
              "DEFER_QUESTION",
              "ADD_NOTE",
              "RETIRE_NOTE",
              "EXPIRE_NOTE"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "TASK",
                    "EXPERIENCE"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9_.:-]{1,128}",
                  "minLength": 1,
                  "maxLength": 128
                },
                "field_id": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9_.:-]{1,128}",
                  "minLength": 1,
                  "maxLength": 128
                },
                "reference": {
                  "type": "object",
                  "properties": {
                    "experience_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "[A-Za-z0-9_.:-]+"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "[0-9a-f]{64}"
                    }
                  },
                  "required": [
                    "experience_id",
                    "revision",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16,
            "uniqueItems": true
          },
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]{1,128}",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "blocking": {
            "type": "boolean"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "note": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "type": "string",
                "enum": [
                  "CLAIM",
                  "PROGRESS"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "UNKNOWN",
                  "HYPOTHESIS",
                  "USER_STATED",
                  "TEST_VERIFIED"
                ]
              },
              "confidence": {
                "type": "null"
              },
              "mandatory": {
                "type": "boolean"
              },
              "identity_sensitive": {
                "type": "boolean"
              },
              "expires_at": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 253402300799
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "status",
              "confidence",
              "mandatory",
              "identity_sensitive",
              "expires_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "op",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "expected_configuration_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "caller_id",
    "scope",
    "expected_record_sha256",
    "expected_revision",
    "proposer",
    "review",
    "action",
    "deltas",
    "store_id",
    "task_id",
    "expected_configuration_sha256"
  ],
  "additionalProperties": false
}
