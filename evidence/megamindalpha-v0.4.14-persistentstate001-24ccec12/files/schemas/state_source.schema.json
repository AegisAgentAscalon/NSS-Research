{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "TASK",
        "EXPERIENCE"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]{1,128}",
      "minLength": 1,
      "maxLength": 128
    },
    "field_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]{1,128}",
      "minLength": 1,
      "maxLength": 128
    },
    "reference": {
      "type": "object",
      "properties": {
        "experience_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "experience_id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false
}
