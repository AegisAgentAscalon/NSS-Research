{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "[A-Za-z0-9_.:-]+"
      },
      "uniqueItems": true
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "overlays",
    "evidence_ref"
  ],
  "additionalProperties": false
}
