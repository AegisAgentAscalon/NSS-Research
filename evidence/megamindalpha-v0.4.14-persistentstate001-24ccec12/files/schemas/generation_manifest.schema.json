{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "binding": {
      "$ref": "qualification_binding.schema.json"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "A2"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "A",
                "B",
                "A2"
              ]
            },
            "minItems": 0,
            "maxItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "sha256",
          "requires"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "CORE",
              "A",
              "B",
              "AB",
              "A2",
              "A2B"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "enum": [
                "A",
                "B",
                "A2"
              ]
            },
            "minItems": 0,
            "maxItems": 2,
            "uniqueItems": true
          },
          "ecid": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "members",
          "ecid",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "AB",
              "A",
              "A2B",
              "A2"
            ]
          },
          "destination": {
            "enum": [
              "A",
              "CORE",
              "A2"
            ]
          },
          "mode": {
            "const": "replay"
          },
          "state_policy": {
            "const": "DISCARD_AND_REPLAY"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source",
          "destination",
          "mode",
          "state_policy",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "BOUNDED_NEURAL_PROBE_GENERATION",
        "BOUNDED_CANDIDATE_OVERLAY_GENERATION"
      ]
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "producer_id",
    "binding",
    "members",
    "profiles",
    "transitions",
    "purpose"
  ],
  "additionalProperties": false
}
