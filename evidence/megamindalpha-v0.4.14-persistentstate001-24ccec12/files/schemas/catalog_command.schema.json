{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "caller_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "action": {
          "const": "START"
        },
        "request": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "catalog_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_current": {
              "type": "object",
              "properties": {
                "epoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "generation_sha256": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "epoch",
                "generation_sha256"
              ],
              "additionalProperties": false
            },
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
            },
            "stage": {
              "$ref": "task_stage.schema.json"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true
            },
            "budget": {
              "type": "object",
              "properties": {
                "max_document_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "max_cost_units": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": [
                "max_document_bytes",
                "max_cost_units"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "catalog_sha256",
            "expected_current",
            "task_id",
            "stage",
            "capabilities",
            "pairs",
            "budget"
          ],
          "additionalProperties": false
        },
        "ticket_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "record": {
          "$ref": "task_record.schema.json"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "caller_id",
        "action",
        "request",
        "ticket_id",
        "record"
      ],
      "additionalProperties": false
    },
