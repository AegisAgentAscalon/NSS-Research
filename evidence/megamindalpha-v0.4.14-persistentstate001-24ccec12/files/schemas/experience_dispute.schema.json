{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "expected_revision_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MODEL",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "action": {
      "type": "string",
      "enum": [
        "DISPUTE"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "conflict_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "support_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9_.:-]+"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "[A-Za-z0-9_.:-]+"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "USER_REPORT",
                  "TOOL_RESULT",
                  "MODEL_OUTPUT",
                  "SYNTHETIC",
                  "REFERENCE",
                  "TASK_SNAPSHOT",
                  "POLICY"
                ]
              },
              "author": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "[A-Za-z0-9_.:-]+"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "HUMAN",
                      "MODEL",
                      "SYSTEM",
                      "UNKNOWN"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "version"
                ],
                "additionalProperties": false
              },
              "recorded_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 20,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "text/plain",
                  "application/json"
                ]
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "[0-9a-f]{64}"
              },
              "generator": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "[A-Za-z0-9_.:-]+"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "HUMAN",
                      "MODEL",
                      "SYSTEM",
                      "UNKNOWN"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "version"
                ],
                "additionalProperties": false
              },
              "parent_source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "[A-Za-z0-9_.:-]+"
                },
                "minItems": 0,
                "maxItems": 32
              },
              "rights_note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "content": {
                "type": "string",
                "minLength": 0,
                "maxLength": 262144
              }
            },
            "required": [
              "id",
              "kind",
              "author",
              "recorded_at",
              "media_type",
              "sha256",
              "generator",
              "parent_source_ids",
              "rights_note",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "conflict_id",
        "support_ids",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "experience_id",
    "expected_revision_hash",
    "actor",
    "at",
    "reason",
    "action",
    "payload"
  ],
  "additionalProperties": false
}
