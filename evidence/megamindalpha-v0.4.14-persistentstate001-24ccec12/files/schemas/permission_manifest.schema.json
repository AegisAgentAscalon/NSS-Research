{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "MegaMindAlpha.LocalNexusPermissions002"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "policy_sha256": {
      "const": "11a2e3c1d26e9d7b12d098d853135da88f40c68efcc00054e564fca0a79d7e7a"
    },
    "operators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ISSUER",
                "EXECUTOR",
                "RECONCILER"
              ]
            }
          }
        },
        "required": [
          "id",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "format",
    "store_id",
    "policy_sha256",
    "operators"
  ],
  "additionalProperties": false
}
