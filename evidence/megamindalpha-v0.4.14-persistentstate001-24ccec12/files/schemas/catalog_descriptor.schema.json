{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "MegaMindAlpha.OverlayCatalogController001"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "generation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "author_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "policy": {
      "const": "exact_profile_declared_cost_v1"
    },
    "claim_scope": {
      "const": "REVIEWED_ROUTING_FIXTURE_NOT_NEW_NEURAL_EVIDENCE"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "CORE",
              "A",
              "B",
              "AB",
              "A2",
              "A2B"
            ]
          },
          "ecid": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "sealed_document_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "load_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "step_units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "max_pairs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": [
          "id",
          "ecid",
          "capabilities",
          "sealed_document_bytes",
          "load_units",
          "step_units",
          "max_pairs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "format",
    "catalog_id",
    "generation_sha256",
    "author_id",
    "policy",
    "claim_scope",
    "profiles"
  ],
  "additionalProperties": false
}
