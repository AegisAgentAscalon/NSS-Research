{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cycle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approver_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    }
  },
  "required": [
    "cycle_id",
    "plan_sha256",
    "approver_id",
    "expires_at"
  ],
  "additionalProperties": false
}
