{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "kind": {
      "type": "string",
      "enum": [
        "USER_REPORT",
        "TOOL_RESULT",
        "MODEL_OUTPUT",
        "SYNTHETIC",
        "REFERENCE",
        "TASK_SNAPSHOT",
        "POLICY"
      ]
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MODEL",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "recorded_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "text/plain",
        "application/json"
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "generator": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MODEL",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "parent_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_.:-]+"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "rights_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "id",
    "kind",
    "author",
    "recorded_at",
    "media_type",
    "sha256",
    "generator",
    "parent_source_ids",
    "rights_note"
  ],
  "additionalProperties": false
}
