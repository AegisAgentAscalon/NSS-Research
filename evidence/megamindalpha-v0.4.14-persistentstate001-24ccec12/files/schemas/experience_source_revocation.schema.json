{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MODEL",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "permission_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "memory",
        "retrieval",
        "training",
        "redistribution"
      ]
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "actor",
    "at",
    "reason",
    "permission_ref",
    "source_sha256",
    "purpose"
  ],
  "additionalProperties": false
}
