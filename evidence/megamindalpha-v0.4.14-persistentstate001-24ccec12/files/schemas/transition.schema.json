{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "destination": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "state_reuse_policy": {
      "type": "string",
      "enum": [
        "reuse",
        "replay"
      ]
    },
    "invalidate": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cache",
          "draft"
        ]
      },
      "uniqueItems": true
    },
    "replay_required": {
      "type": "boolean"
    },
    "failure_destination": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "source",
    "destination",
    "state_reuse_policy",
    "invalidate",
    "replay_required",
    "failure_destination",
    "evidence_ref"
  ],
  "additionalProperties": false
}
