{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  },
  "required": [
    "path",
    "sha256"
  ],
  "additionalProperties": false
}
