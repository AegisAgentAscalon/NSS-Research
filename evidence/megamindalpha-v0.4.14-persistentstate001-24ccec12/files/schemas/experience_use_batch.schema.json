{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "experience_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9_.:-]+"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          }
        },
        "required": [
          "experience_id",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "purpose": {
      "type": "string",
      "enum": [
        "memory",
        "retrieval",
        "training",
        "redistribution"
      ]
    }
  },
  "required": [
    "references",
    "purpose"
  ],
  "additionalProperties": false
}
