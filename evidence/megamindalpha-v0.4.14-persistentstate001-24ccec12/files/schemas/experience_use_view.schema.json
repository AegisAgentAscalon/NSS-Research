{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reference": {
      "type": "object",
      "properties": {
        "experience_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "experience_id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "enum": [
        "memory",
        "retrieval",
        "training",
        "redistribution"
      ]
    },
    "statement": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "support_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9_.:-]+"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "kind": {
          "type": "string",
          "enum": [
            "INTERPRETATION",
            "CORRECTION"
          ]
        },
        "author": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "kind": {
              "type": "string",
              "enum": [
                "HUMAN",
                "MODEL",
                "SYSTEM",
                "UNKNOWN"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "recorded_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20,
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "text",
        "uncertainty",
        "support_ids",
        "kind",
        "author",
        "recorded_at",
        "supersedes"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9_.:-]+"
          },
          "kind": {
            "type": "string",
            "enum": [
              "USER_REPORT",
              "TOOL_RESULT",
              "MODEL_OUTPUT",
              "SYNTHETIC",
              "REFERENCE",
              "TASK_SNAPSHOT",
              "POLICY"
            ]
          },
          "author": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "[A-Za-z0-9_.:-]+"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "HUMAN",
                  "MODEL",
                  "SYSTEM",
                  "UNKNOWN"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "id",
              "kind",
              "version"
            ],
            "additionalProperties": false
          },
          "recorded_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 20,
            "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "application/json"
            ]
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          },
          "generator": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "[A-Za-z0-9_.:-]+"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "HUMAN",
                  "MODEL",
                  "SYSTEM",
                  "UNKNOWN"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "id",
              "kind",
              "version"
            ],
            "additionalProperties": false
          },
          "parent_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "rights_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "kind",
          "author",
          "recorded_at",
          "media_type",
          "sha256",
          "generator",
          "parent_source_ids",
          "rights_note"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "observation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "TASK_STAGE",
            "EXTERNAL_RECORD"
          ]
        },
        "execution": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "stage_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "checkpoint_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "[0-9a-f]{64}"
            },
            "ecid": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "[0-9a-f]{64}"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "core_generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "core_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "[0-9a-f]{64}"
            },
            "task_record_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "[0-9a-f]{64}"
            },
            "capture_request_sha256": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 64,
              "maxLength": 64,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "task_id",
            "stage_id",
            "checkpoint_sha256",
            "ecid",
            "profile",
            "core_generation",
            "core_sha256",
            "task_record_sha256",
            "capture_request_sha256"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "outcome": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "SUCCEEDED",
            "FAILED",
            "PARTIAL"
          ]
        },
        "check_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "kind",
        "execution",
        "summary",
        "outcome",
        "check_refs"
      ],
      "additionalProperties": false
    },
    "family_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "ORDINARY",
        "PRIVATE",
        "IDENTITY_SENSITIVE"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING_REVIEW",
            "APPROVED",
            "REJECTED",
            "QUARANTINED",
            "WITHDRAWN"
          ]
        },
        "reviewer": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "kind": {
              "type": "string",
              "enum": [
                "HUMAN",
                "MODEL",
                "SYSTEM",
                "UNKNOWN"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 20,
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      },
      "required": [
        "status",
        "reviewer",
        "at",
        "reason"
      ],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "ALLOWED",
            "DENIED",
            "REVOKED"
          ]
        },
        "actor": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "[A-Za-z0-9_.:-]+"
            },
            "kind": {
              "type": "string",
              "enum": [
                "HUMAN",
                "MODEL",
                "SYSTEM",
                "UNKNOWN"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 20,
          "maxLength": 20,
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        "permission_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "status",
        "actor",
        "at",
        "reason",
        "permission_ref"
      ],
      "additionalProperties": false
    },
    "source_revocation_status": {
      "type": "string",
      "enum": [
        "CLEAR"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "local-attestation-v1"
      ]
    }
  },
  "required": [
    "reference",
    "purpose",
    "statement",
    "sources",
    "observation",
    "family_id",
    "sensitivity",
    "updated_at",
    "review",
    "permission",
    "source_revocation_status",
    "scope"
  ],
  "additionalProperties": false
}
