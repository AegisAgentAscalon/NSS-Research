{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "MegaMindAlpha.BoundedLearnerCoordinator001"
    },
    "producer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "approver_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "format",
    "producer_ids",
    "approver_ids"
  ],
  "additionalProperties": false
}
