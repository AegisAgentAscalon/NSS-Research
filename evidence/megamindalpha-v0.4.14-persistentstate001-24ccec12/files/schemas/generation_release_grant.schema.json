{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "max_uses": {
      "type": "integer",
      "const": 1
    },
    "policy_sha256": {
      "const": "1ec86e755db7560cdb4a1391be72a432613983b3e5429109cb03bf3e5dbf107b"
    },
    "authority": {
      "const": "TRUSTED_LOCAL_GENERATION_CATALOG"
    },
    "catalog_publication_authorized": {
      "const": true
    },
    "runtime_execution_permit": {
      "const": false
    },
    "production_deployment_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "request_sha256",
    "issuer_id",
    "issued_at",
    "expires_at",
    "max_uses",
    "policy_sha256",
    "authority",
    "catalog_publication_authorized",
    "runtime_execution_permit",
    "production_deployment_authorized"
  ],
  "additionalProperties": false
}
