{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "operation": {
      "const": "PUBLISH_LOCAL_OVERLAY_GENERATION"
    },
    "caller_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_current": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "generation_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "epoch",
        "generation_sha256"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mode": {
      "enum": [
        "BOOTSTRAP",
        "UPDATE",
        "ROLLBACK"
      ]
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "operation",
    "caller_id",
    "target_sha256",
    "generation_certificate_sha256",
    "expected_current",
    "reason",
    "mode"
  ],
  "additionalProperties": false
}
