{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HUMAN",
        "MODEL",
        "SYSTEM",
        "UNKNOWN"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "id",
    "kind",
    "version"
  ],
  "additionalProperties": false
}
