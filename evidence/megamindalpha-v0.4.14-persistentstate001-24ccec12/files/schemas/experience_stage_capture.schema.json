{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MODEL",
            "SYSTEM",
            "UNKNOWN"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "family_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "ORDINARY",
        "PRIVATE",
        "IDENTITY_SENSITIVE"
      ]
    },
    "statement": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "support_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9_.:-]+"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "text",
        "uncertainty",
        "support_ids"
      ],
      "additionalProperties": false
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "expected_checkpoint_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "outcome": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED",
        "PARTIAL"
      ]
    },
    "check_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "experience_id",
    "actor",
    "at",
    "family_id",
    "sensitivity",
    "statement",
    "task_id",
    "expected_checkpoint_hash",
    "summary",
    "outcome",
    "check_refs"
  ],
  "additionalProperties": false
}
