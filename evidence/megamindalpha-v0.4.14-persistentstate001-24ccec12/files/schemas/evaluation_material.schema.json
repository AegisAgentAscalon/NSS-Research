{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "MegaMindAlpha.EvaluationMaterial001"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "[0-9a-f]{64}"
          },
          "role": {
            "type": "string",
            "enum": [
              "manifest",
              "operation",
              "suite",
              "fixture"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          }
        },
        "required": [
          "path",
          "sha256",
          "role",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "implementation": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "evaluation-integer-v1"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "[0-9a-f]{64}"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256
        },
        "environment": {
          "type": "object",
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "implementation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "machine": {
              "type": "string",
              "minLength": 0,
              "maxLength": 128
            }
          },
          "required": [
            "python",
            "implementation",
            "platform",
            "machine"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "version",
        "files",
        "environment",
        "sha256"
      ],
      "additionalProperties": false
    },
    "development_observation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[A-Za-z0-9_.:-]+"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "split": {
          "type": "string",
          "enum": [
            "validation"
          ]
        },
        "examples_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "[0-9a-f]{64}"
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "snapshot_id",
        "sha256",
        "split",
        "examples_sha256",
        "member_count"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "format",
    "files",
    "implementation",
    "development_observation"
  ],
  "additionalProperties": false
}
