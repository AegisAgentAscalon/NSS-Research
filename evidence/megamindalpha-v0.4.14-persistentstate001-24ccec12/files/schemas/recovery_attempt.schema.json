{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "task_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "source_checkpoint_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "source_profile": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "source_ecid": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "target_profile": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+"
    },
    "target_ecid": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "input_artifact": {
      "$ref": "artifact.schema.json"
    },
    "action_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "[A-Za-z0-9_.:-]+"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "STAGED",
        "PUBLISHED",
        "FAILED"
      ]
    },
    "staged_checkpoint_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "[0-9a-f]{64}"
    },
    "published_checkpoint_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "[0-9a-f]{64}"
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "detail": {
      "type": "string"
    },
    "task_handoff": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "stage_handoff_request.schema.json"
        },
        "target_record": {
          "$ref": "task_record.schema.json"
        }
      },
      "required": [
        "request",
        "target_record"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "task_id",
    "source_checkpoint_hash",
    "source_profile",
    "source_ecid",
    "target_profile",
    "target_ecid",
    "input_artifact",
    "action_keys",
    "status",
    "staged_checkpoint_hash",
    "published_checkpoint_hash",
    "failure_code",
    "detail"
  ],
  "additionalProperties": false
}
