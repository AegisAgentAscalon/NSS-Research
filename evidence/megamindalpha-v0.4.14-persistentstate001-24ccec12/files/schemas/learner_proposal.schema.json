{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "MegaMindAlpha.BoundedLearnerCoordinator001"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "learning_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent": {
      "$ref": "qualification_binding.schema.json"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "member_count": {
          "type": "integer",
          "const": 2
        }
      },
      "required": [
        "snapshot_id",
        "sha256",
        "member_count"
      ],
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "authority": {
          "const": "NONE"
        }
      },
      "required": [
        "id",
        "plan_sha256",
        "report_sha256",
        "verdict",
        "authority"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE"
          ]
        },
        "authority": {
          "const": "NONE"
        }
      },
      "required": [
        "id",
        "plan_sha256",
        "report_sha256",
        "verdict",
        "authority"
      ],
      "additionalProperties": false
    },
    "numerical_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "recommendation": {
      "enum": [
        "INDEPENDENT_REVIEW_REQUIRED",
        "NOT_RECOMMENDED"
      ]
    },
    "qualification_status": {
      "const": "INSUFFICIENT_EVIDENCE"
    },
    "missing_claims": {
      "const": [
        "PROFILE:A2",
        "PROFILE:A2B",
        "DIRECTED_TRANSITIONS_FOR_NEW_CANDIDATE"
      ]
    },
    "authority": {
      "const": "NONE"
    },
    "deployment_authorized": {
      "const": false
    },
    "runtime_execution_permit": {
      "const": false
    },
    "scope": {
      "const": "Fixed A2 overlay recipe; no self-qualification or successor-Core authority"
    }
  },
  "required": [
    "schema_version",
    "format",
    "cycle_id",
    "learning_plan_sha256",
    "parent",
    "snapshot",
    "training",
    "evaluation",
    "numerical_verdict",
    "recommendation",
    "qualification_status",
    "missing_claims",
    "authority",
    "deployment_authorized",
    "runtime_execution_permit",
    "scope"
  ],
  "additionalProperties": false
}
