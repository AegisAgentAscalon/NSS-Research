{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9_.:-]+",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "parent_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "[0-9a-f]{64}"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "original_request": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_id": {
          "type": "string",
          "pattern": "[A-Za-z0-9_.:-]+",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "text",
        "source_id"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "document",
              "policy",
              "tool",
              "synthetic"
            ]
          },
          "artifact": {
            "$ref": "artifact.schema.json"
          }
        },
        "required": [
          "id",
          "kind",
          "artifact"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 2048
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 2048
          },
          "source_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "source_field": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "value",
          "unit",
          "source_id",
          "source_field"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9_.:-]+",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "text",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "blocking"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "question_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "question_id",
          "answer",
          "source_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "checked_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "check_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "producer_ecid": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Za-z0-9_.:-]+",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "text",
          "check_ref",
          "producer_ecid",
          "source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "policy"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "text",
          "origin",
          "source_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "[A-Za-z0-9_.:-]+",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "mock_action",
              "presented_output"
            ]
          },
          "receipt": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        },
        "required": [
          "key",
          "kind",
          "receipt"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "stage": {
      "$ref": "task_stage.schema.json"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "parent_hash",
    "goal",
    "original_request",
    "sources",
    "facts",
    "assumptions",
    "unresolved_questions",
    "clarifications",
    "checked_results",
    "constraints",
    "receipts",
    "stage"
  ],
  "additionalProperties": false
}
